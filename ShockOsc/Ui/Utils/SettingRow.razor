@* Label and optional description on the left, control on the right. *@

<div class="d-flex align-center justify-space-between gap-4 py-3">
    <div>
        <MudText Typo="Typo.body2">@Label</MudText>
        @if (Description is not null)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Description</MudText>
        }
    </div>
    <div class="d-flex align-center gap-3 flex-none">
        @ChildContent
    </div>
</div>

@code {

    [Parameter] public string Label { get; set; } = string.Empty;

    [Parameter] public string? Description { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

}
