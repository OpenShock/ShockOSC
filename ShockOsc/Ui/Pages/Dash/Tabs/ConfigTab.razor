@using System.Globalization
@using System.Net
@using OpenShock.Desktop.ModuleBase
@using OpenShock.Desktop.ModuleBase.Config
@using OpenShock.ShockOSC.Config
@using OpenShock.ShockOSC.Services
@using OpenShock.ShockOSC.Ui.Utils
@using OpenShock.Internal.Common.Utils
@implements IDisposable

@page "/dash/config"

<SettingsPage Title="Configuration"
              Description="Global defaults for the _All group. Individual groups can override them.">

    <SettingSection Icon="@Icons.Material.Filled.Bolt" Title="Intensity">
        <HeaderContent>
            <MudToggleGroup T="string" @bind-Value="RandomIntensityString" Style="width: 220px;"
                            Delimiters="true" CheckMark="false" FixedContent="false"
                            @bind-Value:after="OnSettingsValueChangeAsync">
                <MudToggleItem Value="@("Fixed")"/>
                <MudToggleItem Value="@("Random")"/>
            </MudToggleGroup>
        </HeaderContent>
        <ChildContent>
            @if (!ModuleConfig.Config.Behaviour.RandomIntensity)
            {
                <SettingField Label="Intensity" Value="@($"{ModuleConfig.Config.Behaviour.FixedIntensity}%")">
                    <DebouncedSlider T="byte" Size="Size.Medium" Min="0" Max="100" Class="flex-grow-1 px-2"
                                     @bind-SliderValue="@ModuleConfig.Config.Behaviour.FixedIntensity"
                                     OnSaveAction="_ => OnSettingsValueChange()"/>
                </SettingField>
            }
            else
            {
                <SettingField Label="Minimum" Value="@($"{ModuleConfig.Config.Behaviour.IntensityRange.Min}%")">
                    <DebouncedSlider T="byte" Size="Size.Medium" Min="0" Max="100" Class="flex-grow-1 px-2"
                                     @bind-SliderValue="@ModuleConfig.Config.Behaviour.IntensityRange.Min"
                                     OnValueChanged="u => { if (ModuleConfig.Config.Behaviour.IntensityRange.Max < u) ModuleConfig.Config.Behaviour.IntensityRange.Max = u; }"
                                     OnSaveAction="_ => OnSettingsValueChange()"/>
                </SettingField>

                <MudDivider/>

                <SettingField Label="Maximum" Value="@($"{ModuleConfig.Config.Behaviour.IntensityRange.Max}%")">
                    <DebouncedSlider T="byte" Size="Size.Medium" Min="0" Max="100" Class="flex-grow-1 px-2"
                                     @bind-SliderValue="@ModuleConfig.Config.Behaviour.IntensityRange.Max"
                                     OnValueChanged="u => { if (ModuleConfig.Config.Behaviour.IntensityRange.Min > u) ModuleConfig.Config.Behaviour.IntensityRange.Min = u; }"
                                     OnSaveAction="_ => OnSettingsValueChange()"/>
                </SettingField>

                <MudDivider/>

                <SettingRow Label="Pull trigger random"
                            Description="Pick a random value from the range instead of scaling intensity with pull distance.">
                    <MudSwitch T="bool" Color="Color.Primary"
                               @bind-Value="ModuleConfig.Config.Behaviour.OnPullTriggerRandomBehavior"
                               @bind-Value:after="OnSettingsValueChangeAsync"/>
                </SettingRow>
            }
        </ChildContent>
    </SettingSection>

    <SettingSection Icon="@Icons.Material.Filled.Timer" Title="Duration">
        <HeaderContent>
            <MudToggleGroup T="string" @bind-Value="RandomDurationString" Style="width: 220px;"
                            Delimiters="true" CheckMark="false" FixedContent="false"
                            @bind-Value:after="OnSettingsValueChangeAsync">
                <MudToggleItem Value="@("Fixed")"/>
                <MudToggleItem Value="@("Random")"/>
            </MudToggleGroup>
        </HeaderContent>
        <ChildContent>
            @if (!ModuleConfig.Config.Behaviour.RandomDuration)
            {
                <SettingField Label="Duration" Value="@FormatSeconds(ModuleConfig.Config.Behaviour.FixedDuration)">
                    <DebouncedSlider T="ushort" Size="Size.Medium" Min="300" Max="30000" Step="100"
                                     Class="flex-grow-1 px-2"
                                     @bind-SliderValue="@ModuleConfig.Config.Behaviour.FixedDuration"
                                     OnSaveAction="_ => OnSettingsValueChange()"/>
                </SettingField>
            }
            else
            {
                <SettingField Label="Minimum" Value="@FormatSeconds(ModuleConfig.Config.Behaviour.DurationRange.Min)">
                    <DebouncedSlider T="ushort" Size="Size.Medium" Min="300" Max="30000" Step="100"
                                     Class="flex-grow-1 px-2"
                                     @bind-SliderValue="@ModuleConfig.Config.Behaviour.DurationRange.Min"
                                     OnValueChanged="u => { if (ModuleConfig.Config.Behaviour.DurationRange.Max < u) ModuleConfig.Config.Behaviour.DurationRange.Max = u; }"
                                     OnSaveAction="_ => OnSettingsValueChange()"/>
                </SettingField>

                <MudDivider/>

                <SettingField Label="Maximum" Value="@FormatSeconds(ModuleConfig.Config.Behaviour.DurationRange.Max)">
                    <DebouncedSlider T="ushort" Size="Size.Medium" Min="300" Max="30000" Step="100"
                                     Class="flex-grow-1 px-2"
                                     @bind-SliderValue="@ModuleConfig.Config.Behaviour.DurationRange.Max"
                                     OnValueChanged="u => { if (ModuleConfig.Config.Behaviour.DurationRange.Min > u) ModuleConfig.Config.Behaviour.DurationRange.Min = u; }"
                                     OnSaveAction="_ => OnSettingsValueChange()"/>
                </SettingField>
            }
        </ChildContent>
    </SettingSection>

    <SettingSection Icon="@Icons.Material.Filled.HourglassBottom" Title="Timing">
        <SettingField Label="Cooldown" Value="@FormatSeconds(ModuleConfig.Config.Behaviour.CooldownTime)"
                      Description="Time a group has to wait after a trigger before it can fire again.">
            <DebouncedSlider T="uint" Size="Size.Medium" Min="0" Max="30000" Step="500"
                             Class="flex-grow-1 px-2"
                             @bind-SliderValue="@ModuleConfig.Config.Behaviour.CooldownTime"
                             OnSaveAction="_ => OnSettingsValueChange()"/>
            <MudNumericField T="double" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-none"
                             Style="width: 110px;" Adornment="Adornment.End" AdornmentText="s"
                             Min="0" Max="30" Step="0.5" Format="0.#"
                             @bind-Value="CooldownSeconds"
                             @bind-Value:after="OnSettingsValueChangeAsync"/>
        </SettingField>

        <MudDivider/>

        <SettingField Label="Hold time" Value="@($"{ModuleConfig.Config.Behaviour.HoldTime} ms")"
                      Description="How long a manual trigger has to stay active before it fires.">
            <DebouncedSlider T="uint" Size="Size.Medium" Min="0" Max="1000" Step="10"
                             Class="flex-grow-1 px-2"
                             @bind-SliderValue="@ModuleConfig.Config.Behaviour.HoldTime"
                             OnSaveAction="_ => OnSettingsValueChange()"/>
            <MudNumericField T="uint" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-none"
                             Style="width: 110px;" Adornment="Adornment.End" AdornmentText="ms" Min="0"
                             @bind-Value="ModuleConfig.Config.Behaviour.HoldTime"
                             @bind-Value:after="OnSettingsValueChangeAsync"/>
        </SettingField>
    </SettingSection>

    <SettingSection Icon="@Icons.Material.Filled.Vibration" Title="PhysBone">
        <SettingRow Label="While held" Description="Action performed continuously while the bone is grabbed.">
            <MudSelect T="BoneAction" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                       Style="width: 180px;"
                       @bind-Value="ModuleConfig.Config.Behaviour.WhileBoneHeld"
                       @bind-Value:after="OnSettingsValueChangeAsync">
                @foreach (var boneHeldAction in BoneActionExtensions.BoneActions)
                {
                    <MudSelectItem Value="@boneHeldAction">@boneHeldAction</MudSelectItem>
                }
            </MudSelect>
        </SettingRow>

        <MudDivider/>

        <SettingRow Label="When released" Description="Action performed once the bone is let go.">
            <MudSelect T="BoneAction" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                       Style="width: 180px;"
                       @bind-Value="ModuleConfig.Config.Behaviour.WhenBoneReleased"
                       @bind-Value:after="OnSettingsValueChangeAsync">
                @foreach (var boneReleasedAction in BoneActionExtensions.BoneActions)
                {
                    <MudSelectItem Value="@boneReleasedAction">@boneReleasedAction</MudSelectItem>
                }
            </MudSelect>
        </SettingRow>

        <MudDivider/>

        <SettingRow Label="Limit held duration" Description="Stop the held action after a maximum amount of time.">
            <MudNumericField T="double" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-none"
                             Style="width: 110px;" Adornment="Adornment.End" AdornmentText="s"
                             Min="0" Max="60" Step="0.5" Format="0.#"
                             Disabled="!_limitBoneHeldDurationEnabled"
                             @bind-Value="BoneHeldDurationLimitSeconds"
                             @bind-Value:after="OnSettingsValueChangeAsync"/>
            <MudSwitch T="bool" Color="Color.Primary"
                       @bind-Value="_limitBoneHeldDurationEnabled"
                       @bind-Value:after="OnSettingsValueChangeAsync"/>
        </SettingRow>
    </SettingSection>

    <SettingSection Icon="@Icons.Material.Filled.SportsEsports" Title="Game">
        <SettingRow Label="Kill switch" Description="Blocks every command ShockOSC would send.">
            <MudSwitch T="bool" Color="Color.Error"
                       @bind-Value="UnderscoreConfig.KillSwitch"
                       @bind-Value:after="OnSettingsValueChangeAsync"/>
        </SettingRow>

        <MudDivider/>

        <SettingRow Label="Disable while AFK" Description="Ignore triggers while VRChat reports you as away.">
            <MudSwitch T="bool" Color="Color.Primary"
                       @bind-Value="ModuleConfig.Config.Behaviour.DisableWhileAfk"
                       @bind-Value:after="OnSettingsValueChangeAsync"/>
        </SettingRow>

        <MudDivider/>

        <SettingRow Label="Force unmute" Description="Unmute your microphone when a shock is sent.">
            <MudSwitch T="bool" Color="Color.Primary"
                       @bind-Value="ModuleConfig.Config.Behaviour.ForceUnmute"
                       @bind-Value:after="OnSettingsValueChangeAsync"/>
        </SettingRow>
    </SettingSection>

    <SettingSection Icon="@Icons.Material.Filled.Cable" Title="OSC">
        <HeaderContent>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Requires restart</MudText>
        </HeaderContent>
        <ChildContent>
            <SettingRow Label="Allow any IP" Description="Listen on all interfaces instead of localhost only (Quest).">
                <MudSwitch T="bool" Color="Color.Primary"
                           @bind-Value="ModuleConfig.Config.Osc.QuestSupport"
                           @bind-Value:after="OnSettingsValueChange"/>
            </SettingRow>

            <MudDivider/>

            <SettingRow Label="OSC Query" Description="Discover VRChat and its ports automatically.">
                <MudSwitch T="bool" Color="Color.Primary"
                           @bind-Value="ModuleConfig.Config.Osc.OscQuery"
                           @bind-Value:after="OnSettingsValueChange"/>
            </SettingRow>

            <MudCollapse Expanded="@(!ModuleConfig.Config.Osc.OscQuery)">
                <MudDivider/>

                <SettingRow Label="Send port" Description="Port ShockOSC sends parameters to.">
                    <MudNumericField T="ushort" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-none"
                                     Style="width: 150px;" Min="1" Max="65535" HideSpinButtons="true"
                                     @bind-Value="ModuleConfig.Config.Osc.OscSendPort"
                                     @bind-Value:after="OnSettingsValueChange"/>
                </SettingRow>

                <MudDivider/>

                <SettingRow Label="Receive port" Description="Port ShockOSC listens on for parameters.">
                    <MudNumericField T="ushort" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-none"
                                     Style="width: 150px;" Min="1" Max="65535" HideSpinButtons="true"
                                     @bind-Value="ModuleConfig.Config.Osc.OscReceivePort"
                                     @bind-Value:after="OnSettingsValueChange"/>
                </SettingRow>

                <MudDivider/>

                <SettingRow Label="Send IP" Description="Address the OSC messages are sent to.">
                    <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-none"
                                  Style="width: 150px;" Error="@(!IsSendIpValid)" ErrorText="Invalid IP address"
                                  @bind-Value="ModuleConfig.Config.Osc.OscSendIp"
                                  @bind-Value:after="OnSettingsValueChange"/>
                </SettingRow>
            </MudCollapse>
        </ChildContent>
    </SettingSection>

    <MudPaper Outlined="true" Class="rounded-lg">
        <MudExpansionPanels Elevation="0">
            <MudExpansionPanel HeaderClass="@SettingSection.HeaderClass">
                <TitleContent>
                    <div class="d-flex align-center gap-3">
                        <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" Color="Color.Primary"/>
                        <MudText Typo="Typo.overline" Style="@SettingSection.TitleStyle">Advanced</MudText>
                    </div>
                </TitleContent>
                <ChildContent>
                    <SettingField Label="Check loop interval"
                                  Value="@($"{ModuleConfig.Config.Behaviour.CheckLoopIntervalMs} ms")"
                                  Description="How often incoming parameters are evaluated. Lower reacts faster but uses more CPU.">
                        <DebouncedSlider T="uint" Size="Size.Medium" Min="10" Max="200" Step="5"
                                         Class="flex-grow-1 px-2"
                                         @bind-SliderValue="@ModuleConfig.Config.Behaviour.CheckLoopIntervalMs"
                                         OnSaveAction="_ => OnSettingsValueChange()"/>
                        <MudNumericField T="uint" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-none"
                                         Style="width: 110px;" Adornment="Adornment.End" AdornmentText="ms" Min="10"
                                         @bind-Value="ModuleConfig.Config.Behaviour.CheckLoopIntervalMs"
                                         @bind-Value:after="OnSettingsValueChangeAsync"/>
                    </SettingField>
                </ChildContent>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudPaper>

</SettingsPage>

@code {

    [ModuleInject] private UnderscoreConfig UnderscoreConfig { get; set; } = null!;
    [ModuleInject] private IModuleConfig<ShockOscConfig> ModuleConfig { get; set; } = null!;

    private const string Fixed = "Fixed";
    private const string Random = "Random";

    private string RandomIntensityString
    {
        get => ModuleConfig.Config.Behaviour.RandomIntensity ? Random : Fixed;
        set => ModuleConfig.Config.Behaviour.RandomIntensity = value == Random;
    }

    private string RandomDurationString
    {
        get => ModuleConfig.Config.Behaviour.RandomDuration ? Random : Fixed;
        set => ModuleConfig.Config.Behaviour.RandomDuration = value == Random;
    }

    private bool IsSendIpValid => IPAddress.TryParse(ModuleConfig.Config.Osc.OscSendIp, out _);

    private static string FormatSeconds(uint milliseconds) =>
        MathF.Round(milliseconds / 1000f, 1).ToString(CultureInfo.InvariantCulture) + "s";

    /// <summary>
    /// Both of these are stored in milliseconds but edited in seconds, so the field matches the
    /// value shown above the slider. Rounded on the way back so 2.5 s stores as exactly 2500 ms.
    /// </summary>
    private static uint ToMilliseconds(double seconds, uint max) =>
        (uint)Math.Clamp(Math.Round(seconds * 1000d), 0d, max);

    private double CooldownSeconds
    {
        get => ModuleConfig.Config.Behaviour.CooldownTime / 1000d;
        set => ModuleConfig.Config.Behaviour.CooldownTime = ToMilliseconds(value, 30_000);
    }

    private double BoneHeldDurationLimitSeconds
    {
        get => _limitBoneHeldDuration / 1000d;
        set => _limitBoneHeldDuration = ToMilliseconds(value, 60_000);
    }

    private uint _limitBoneHeldDuration;
    private bool _limitBoneHeldDurationEnabled;

    private void OnSettingsValueChange()
    {
        OsTask.Run(OnSettingsValueChangeAsync);
    }

    private Task OnSettingsValueChangeAsync()
    {
        ModuleConfig.Config.Behaviour.BoneHeldDurationLimit = _limitBoneHeldDurationEnabled ? _limitBoneHeldDuration : null;

        ModuleConfig.SaveDeferred();
        return UnderscoreConfig.SendUpdateForAll();
    }

    protected override void OnInitialized()
    {
        _limitBoneHeldDurationEnabled = ModuleConfig.Config.Behaviour.BoneHeldDurationLimit.HasValue;
        _limitBoneHeldDuration = ModuleConfig.Config.Behaviour.BoneHeldDurationLimit ?? 2000;

        UnderscoreConfig.OnConfigUpdate += OnConfigUpdate;
    }

    private void OnConfigUpdate()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UnderscoreConfig.OnConfigUpdate -= OnConfigUpdate;
    } 

}
