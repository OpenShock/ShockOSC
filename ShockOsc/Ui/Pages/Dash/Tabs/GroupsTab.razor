@using System.Globalization
@using System.Text.RegularExpressions
@using OpenShock.Desktop.ModuleBase
@using OpenShock.Desktop.ModuleBase.Api
@using OpenShock.Desktop.ModuleBase.Config
@using OpenShock.Desktop.ModuleBase.StableInterfaces
@using OpenShock.ShockOSC.Config
@using OpenShock.ShockOSC.Services
@using OpenShock.ShockOSC.Ui.Utils
@using Group = OpenShock.ShockOSC.Config.Group
@using ProgramGroup = OpenShock.ShockOSC.Models.ProgramGroup

@page "/dash/groups"
@implements IDisposable

<SettingsPage Title="Groups" Description="A group targets a set of shockers and can override the global defaults.">
    <HeaderContent>
        <MudButton OnClick="AddGroup" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                   Color="Color.Primary">
            Add group
        </MudButton>
    </HeaderContent>
    <ChildContent>

        <SettingSection Icon="@Icons.Material.Filled.Group" Title="Group">
            <SettingRow Label="Selected group" Description="Pick the group to edit.">
                <MudSelect T="Guid?" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                           Style="width: 220px;" Clearable="true" @bind-Value="Group">
                    @foreach (var group in ModuleConfig.Config.Groups)
                    {
                        <MudSelectItem T="Guid?" Value="@group.Key">@group.Value.Name</MudSelectItem>
                    }
                </MudSelect>
            </SettingRow>

            @if (CurrentGroup != null && CurrentProgramGroup != null)
            {
                <MudDivider/>

                <SettingRow Label="Name" Description="Used for the avatar parameters of this group.">
                    <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-none"
                                  Style="width: 220px;" DebounceInterval="250"
                                  Validation="@(new Func<string, string>(NameValidation))"
                                  @bind-Value="@CurrentGroup.Name" @bind-Value:after="OnSettingsValueChange"/>
                </SettingRow>

                <MudDivider/>

                <SettingRow Label="Paused" Description="Ignore every trigger aimed at this group.">
                    <MudSwitch T="bool" Color="Color.Warning" @bind-Value="@CurrentProgramGroup.Paused"
                               @bind-Value:after="OnGroupSettingsValueChange"/>
                </SettingRow>

                <MudDivider/>

                <SettingRow Label="Delete group" Description="Removes the group and its overrides. Cannot be undone.">
                    <MudButton OnClick="DeleteGroup" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small">
                        Delete
                    </MudButton>
                </SettingRow>
            }
        </SettingSection>

        @if (CurrentGroup == null || CurrentProgramGroup == null)
        {
            <MudPaper Outlined="true" Class="rounded-lg px-4 py-3">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Select a group above to edit it, or add a new one.
                </MudText>
            </MudPaper>
        }
        else
        {
            <SettingSection Icon="@Icons.Material.Filled.Bolt" Title="Intensity">
                <HeaderContent>
                    <div class="d-flex align-center gap-2">
                        <MudButton OnClick="ResetIntensity" Variant="Variant.Text" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.LockReset" Color="Color.Primary">
                            Reset
                        </MudButton>
                        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="@CurrentGroup.OverrideIntensity"
                                   @bind-Value:after="OnGroupSettingsValueChange"/>
                    </div>
                </HeaderContent>
                <ChildContent>
                    <MudCollapse Expanded="CurrentGroup.OverrideIntensity">
                        <div class="py-3">
                            <MudToggleGroup T="string" @bind-Value="CurrentRandomIntensityString"
                                            Style="width: 220px;" Delimiters="true" CheckMark="false"
                                            FixedContent="false" @bind-Value:after="OnGroupSettingsValueChange">
                                <MudToggleItem Value="@Fixed"/>
                                <MudToggleItem Value="@Random"/>
                            </MudToggleGroup>
                        </div>

                        <MudDivider/>

                        @if (!CurrentGroup.RandomIntensity)
                        {
                            <SettingField Label="Intensity" Value="@($"{CurrentGroup.FixedIntensity}%")">
                                <DebouncedSlider T="byte" Size="Size.Medium" Min="0" Max="100" Class="flex-grow-1 px-2"
                                                 @bind-SliderValue="@CurrentGroup.FixedIntensity"
                                                 OnSaveAction="_ => ModuleConfig.SaveDeferred()"/>
                            </SettingField>
                        }
                        else
                        {
                            <SettingField Label="Minimum" Value="@($"{CurrentGroup.IntensityRange.Min}%")">
                                <DebouncedSlider T="byte" Size="Size.Medium" Min="0" Max="100" Class="flex-grow-1 px-2"
                                                 @bind-SliderValue="@CurrentGroup.IntensityRange.Min"
                                                 OnValueChanged="u => { if (CurrentGroup.IntensityRange.Max < u) CurrentGroup.IntensityRange.Max = u; }"
                                                 OnSaveAction="_ => ModuleConfig.SaveDeferred()"/>
                            </SettingField>

                            <MudDivider/>

                            <SettingField Label="Maximum" Value="@($"{CurrentGroup.IntensityRange.Max}%")">
                                <DebouncedSlider T="byte" Size="Size.Medium" Min="0" Max="100" Class="flex-grow-1 px-2"
                                                 @bind-SliderValue="@CurrentGroup.IntensityRange.Max"
                                                 OnValueChanged="u => { if (CurrentGroup.IntensityRange.Min > u) CurrentGroup.IntensityRange.Min = u; }"
                                                 OnSaveAction="_ => ModuleConfig.SaveDeferred()"/>
                            </SettingField>

                            <MudDivider/>

                            <SettingRow Label="Pull trigger random"
                                        Description="Pick a random value from the range instead of scaling intensity with pull distance.">
                                <MudSwitch T="bool" Color="Color.Primary"
                                           @bind-Value="@CurrentGroup.OnPullTriggerRandomBehavior"
                                           @bind-Value:after="OnGroupSettingsValueChange"/>
                            </SettingRow>
                        }
                    </MudCollapse>
                </ChildContent>
            </SettingSection>

            <SettingSection Icon="@Icons.Material.Filled.Timer" Title="Duration">
                <HeaderContent>
                    <div class="d-flex align-center gap-2">
                        <MudButton OnClick="ResetDuration" Variant="Variant.Text" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.LockReset" Color="Color.Primary">
                            Reset
                        </MudButton>
                        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="@CurrentGroup.OverrideDuration"
                                   @bind-Value:after="OnGroupSettingsValueChange"/>
                    </div>
                </HeaderContent>
                <ChildContent>
                    <MudCollapse Expanded="CurrentGroup.OverrideDuration">
                        <div class="py-3">
                            <MudToggleGroup T="string" @bind-Value="CurrentRandomDurationString"
                                            Style="width: 220px;" Delimiters="true" CheckMark="false"
                                            FixedContent="false" @bind-Value:after="OnGroupSettingsValueChange">
                                <MudToggleItem Value="@Fixed"/>
                                <MudToggleItem Value="@Random"/>
                            </MudToggleGroup>
                        </div>

                        <MudDivider/>

                        @if (!CurrentGroup.RandomDuration)
                        {
                            <SettingField Label="Duration" Value="@FormatSeconds(CurrentGroup.FixedDuration)">
                                <DebouncedSlider T="ushort" Size="Size.Medium" Min="300" Max="30000" Step="100"
                                                 Class="flex-grow-1 px-2"
                                                 @bind-SliderValue="@CurrentGroup.FixedDuration"
                                                 OnSaveAction="_ => ModuleConfig.SaveDeferred()"/>
                            </SettingField>
                        }
                        else
                        {
                            <SettingField Label="Minimum" Value="@FormatSeconds(CurrentGroup.DurationRange.Min)">
                                <DebouncedSlider T="ushort" Size="Size.Medium" Min="300" Max="30000" Step="100"
                                                 Class="flex-grow-1 px-2"
                                                 @bind-SliderValue="@CurrentGroup.DurationRange.Min"
                                                 OnValueChanged="u => { if (CurrentGroup.DurationRange.Max < u) CurrentGroup.DurationRange.Max = u; }"
                                                 OnSaveAction="_ => ModuleConfig.SaveDeferred()"/>
                            </SettingField>

                            <MudDivider/>

                            <SettingField Label="Maximum" Value="@FormatSeconds(CurrentGroup.DurationRange.Max)">
                                <DebouncedSlider T="ushort" Size="Size.Medium" Min="300" Max="30000" Step="100"
                                                 Class="flex-grow-1 px-2"
                                                 @bind-SliderValue="@CurrentGroup.DurationRange.Max"
                                                 OnValueChanged="u => { if (CurrentGroup.DurationRange.Min > u) CurrentGroup.DurationRange.Min = u; }"
                                                 OnSaveAction="_ => ModuleConfig.SaveDeferred()"/>
                            </SettingField>
                        }
                    </MudCollapse>
                </ChildContent>
            </SettingSection>

            <SettingSection Icon="@Icons.Material.Filled.HourglassBottom" Title="Cooldown">
                <HeaderContent>
                    <MudSwitch T="bool" Color="Color.Primary" @bind-Value="@CurrentGroup.OverrideCooldownTime"
                               @bind-Value:after="OnGroupSettingsValueChange"/>
                </HeaderContent>
                <ChildContent>
                    <MudCollapse Expanded="CurrentGroup.OverrideCooldownTime">
                        <SettingField Label="Cooldown" Value="@FormatSeconds(CurrentGroup.CooldownTime)"
                                      Description="Time this group has to wait after a trigger before it can fire again.">
                            <DebouncedSlider T="uint" Size="Size.Medium" Min="0" Max="30000" Step="500"
                                             Class="flex-grow-1 px-2"
                                             @bind-SliderValue="@CurrentGroup.CooldownTime"
                                             OnSaveAction="_ => ModuleConfig.SaveDeferred()"/>
                            <MudNumericField T="double" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Class="flex-none" Style="width: 110px;" Adornment="Adornment.End"
                                             AdornmentText="s" Min="0" Max="30" Step="0.5" Format="0.#"
                                             @bind-Value="CooldownSeconds"
                                             @bind-Value:after="OnGroupSettingsValueChange"/>
                        </SettingField>
                    </MudCollapse>
                </ChildContent>
            </SettingSection>

            <SettingSection Icon="@Icons.Material.Filled.Vibration" Title="PhysBone held">
                <HeaderContent>
                    <MudSwitch T="bool" Color="Color.Primary" @bind-Value="@CurrentGroup.OverrideBoneHeldAction"
                               @bind-Value:after="OnGroupSettingsValueChange"/>
                </HeaderContent>
                <ChildContent>
                    <MudCollapse Expanded="CurrentGroup.OverrideBoneHeldAction">
                        <SettingRow Label="While held"
                                    Description="Action performed continuously while the bone is grabbed.">
                            <MudSelect T="BoneAction" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                       Style="width: 180px;" @bind-Value="CurrentGroup.WhileBoneHeld"
                                       @bind-Value:after="OnGroupSettingsValueChange">
                                @foreach (var boneHeldAction in BoneActionExtensions.BoneActions)
                                {
                                    <MudSelectItem Value="@boneHeldAction">@boneHeldAction</MudSelectItem>
                                }
                            </MudSelect>
                        </SettingRow>
                    </MudCollapse>
                </ChildContent>
            </SettingSection>

            <SettingSection Icon="@Icons.Material.Filled.Vibration" Title="PhysBone released">
                <HeaderContent>
                    <MudSwitch T="bool" Color="Color.Primary" @bind-Value="@CurrentGroup.OverrideBoneReleasedAction"
                               @bind-Value:after="OnGroupSettingsValueChange"/>
                </HeaderContent>
                <ChildContent>
                    <MudCollapse Expanded="CurrentGroup.OverrideBoneReleasedAction">
                        <SettingRow Label="When released" Description="Action performed once the bone is let go.">
                            <MudSelect T="BoneAction" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                       Style="width: 180px;" @bind-Value="CurrentGroup.WhenBoneReleased"
                                       @bind-Value:after="OnGroupSettingsValueChange">
                                @foreach (var boneReleasedAction in BoneActionExtensions.BoneActions)
                                {
                                    <MudSelectItem Value="@boneReleasedAction">@boneReleasedAction</MudSelectItem>
                                }
                            </MudSelect>
                        </SettingRow>
                    </MudCollapse>
                </ChildContent>
            </SettingSection>

            <SettingSection Icon="@Icons.Material.Filled.TimerOff" Title="Held duration limit">
                <HeaderContent>
                    <MudSwitch T="bool" Color="Color.Primary"
                               @bind-Value="@CurrentGroup.OverrideBoneHeldDurationLimit"
                               @bind-Value:after="OnGroupSettingsValueChange"/>
                </HeaderContent>
                <ChildContent>
                    <MudCollapse Expanded="CurrentGroup.OverrideBoneHeldDurationLimit">
                        <SettingRow Label="Limit held duration"
                                    Description="Stop the held action after a maximum amount of time.">
                            <MudNumericField T="double" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Class="flex-none" Style="width: 110px;" Adornment="Adornment.End"
                                             AdornmentText="s" Min="0" Max="60" Step="0.5" Format="0.#"
                                             Disabled="!_limitBoneHeldDurationEnabled"
                                             @bind-Value="BoneHeldDurationLimitSeconds"
                                             @bind-Value:after="OnGroupSettingsValueChange"/>
                            <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_limitBoneHeldDurationEnabled"
                                       @bind-Value:after="OnGroupSettingsValueChange"/>
                        </SettingRow>
                    </MudCollapse>
                </ChildContent>
            </SettingSection>

            <SettingSection Icon="@Icons.Material.Filled.Bolt" Title="Shockers">
                <HeaderContent>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@_selectedShockers.Count selected</MudText>
                </HeaderContent>
                <ChildContent>
                    <div class="py-3">
                        <MudTable Elevation="0" Height="300px" T="Guid" Dense="true"
                                  Items="AllShockers.Select(x => x.Id)"
                                  MultiSelection="true" Hover="true" @bind-SelectedItems="@_selectedShockers"
                                  @bind-SelectedItems:after="OnSelectedShockersUpdate">
                            <HeaderContent>
                                <MudTh>Name</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Name">
                                    @(AllShockers.FirstOrDefault(x => x.Id == context)?.Name ?? "Unknown shocker")
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                </ChildContent>
            </SettingSection>
        }

    </ChildContent>
</SettingsPage>

@code {

    [ModuleInject] private IModuleConfig<ShockOscConfig> ModuleConfig { get; set; } = null!;
    [ModuleInject] private ShockOsc ShockOsc { get; set; } = null!;
    [ModuleInject] private IOpenShockService OpenShock { get; set; } = null!;
    [ModuleInject] private UnderscoreConfig UnderscoreConfig { get; set; } = null!;

    /// <summary>
    /// Every shocker the user can pick for a group, owned and shared alike. A group that only ever listed owned
    /// shockers could never fire on a shocker somebody shared with us.
    /// </summary>
    private IEnumerable<IOpenShockShocker> AllShockers =>
        OpenShock.Data.Hubs.Value.Concat(OpenShock.Data.SharedHubs.Value).SelectMany(x => x.Shockers);

    private const string Fixed = "Fixed";
    private const string Random = "Random";

    private Guid? _group = null;

    public Guid? Group
    {
        get => _group;
        set
        {
            _group = value;
            OnGroupSelect();
        }
    }

    public async Task AddGroup()
    {
        var groupId = Guid.NewGuid();
        ModuleConfig.Config.Groups.Add(groupId, new Group { Name = "New Group" });
        Group = groupId;

        await InvokeAsync(StateHasChanged);
        ModuleConfig.SaveDeferred();
        ShockOsc.RaiseOnGroupsChanged();
    }

    public async Task DeleteGroup()
    {
        if (Group == null) return;

        ModuleConfig.Config.Groups.Remove(Group.Value);
        Group = null;
        await InvokeAsync(StateHasChanged);
        ModuleConfig.SaveDeferred();
        ShockOsc.RaiseOnGroupsChanged();
    }

    private void OnSettingsValueChange()
    {
        ModuleConfig.SaveDeferred();
        ShockOsc.RaiseOnGroupsChanged();
    }

    private Task OnGroupSettingsValueChange()
    {
        if (CurrentGroup != null)
        {
            CurrentGroup.BoneHeldDurationLimit = _limitBoneHeldDurationEnabled ? _limitBoneHeldDuration : null;
        }

        ModuleConfig.SaveDeferred();
        if (CurrentProgramGroup == null) throw new NullReferenceException("Program Group is null in GroupsTab");
        return UnderscoreConfig.SendUpdateForGroup(CurrentProgramGroup);
    }

    private void OnGroupSelect()
    {
        if (CurrentGroup != null)
        {
            _selectedShockers = [..CurrentGroup.Shockers];

            // Read from the selected group, not the global defaults. OnGroupSettingsValueChange writes
            // these straight back to the group, so a stale value here overwrites the group's own limit.
            _limitBoneHeldDurationEnabled = CurrentGroup.BoneHeldDurationLimit.HasValue;
            _limitBoneHeldDuration = CurrentGroup.BoneHeldDurationLimit ?? 2000;
        }

        InvokeAsync(StateHasChanged);
    }

    private void OnSelectedShockersUpdate()
    {
        if (CurrentGroup != null)
        {
            CurrentGroup.Shockers = _selectedShockers.ToList();
            ModuleConfig.SaveDeferred();
        }
    }

    private Group? CurrentGroup => Group == null ? null : ModuleConfig.Config.Groups.TryGetValue(Group.Value, out var group) ? group : null;

    private ProgramGroup? CurrentProgramGroup => Group == null ? null : UnderscoreConfig.GetProgramGroupFromGUID(Group.Value, out var group) ? group : null;

    private static Regex _nameRegex = new Regex(@"^[a-zA-Z0-9\/\\ -]+$", RegexOptions.Compiled);

    private string NameValidation(string name)
    {
        if (string.IsNullOrEmpty(name)) return "Name cannot be empty";
        if (name.Length > 30) return "Name cannot be longer than 30 characters";
        if (!_nameRegex.IsMatch(name)) return "Can only contain letters, numbers, and /\\- characters, this is due to unity animator parameters restrictions";
        return string.Empty;
    }

    private HashSet<Guid> _selectedShockers = [];

    private string CurrentRandomIntensityString
    {
        get => CurrentGroup?.RandomIntensity ?? false ? Random : Fixed;
        set
        {
            if (CurrentGroup == null) return;
            CurrentGroup.RandomIntensity = value == Random;
        }
    }

    private string CurrentRandomDurationString
    {
        get => CurrentGroup?.RandomDuration ?? false ? Random : Fixed;
        set
        {
            if (CurrentGroup == null) return;
            CurrentGroup.RandomDuration = value == Random;
        }
    }

    private static string FormatSeconds(uint milliseconds) =>
        MathF.Round(milliseconds / 1000f, 1).ToString(CultureInfo.InvariantCulture) + "s";

    private static uint ToMilliseconds(double seconds, uint max) =>
        (uint)Math.Clamp(Math.Round(seconds * 1000d), 0d, max);

    /// <summary>Stored in milliseconds, edited in seconds so the field matches the slider's value.</summary>
    private double CooldownSeconds
    {
        get => CurrentGroup?.CooldownTime / 1000d ?? 0d;
        set
        {
            if (CurrentGroup == null) return;
            CurrentGroup.CooldownTime = ToMilliseconds(value, 30_000);
        }
    }

    private double BoneHeldDurationLimitSeconds
    {
        get => _limitBoneHeldDuration / 1000d;
        set => _limitBoneHeldDuration = ToMilliseconds(value, 60_000);
    }

    private async Task ResetIntensity()
    {
        if (CurrentGroup == null) return;
        CurrentGroup.FixedIntensity = ModuleConfig.Config.Behaviour.FixedIntensity;
        CurrentGroup.IntensityRange = ModuleConfig.Config.Behaviour.IntensityRange;
        CurrentGroup.RandomIntensity = ModuleConfig.Config.Behaviour.RandomIntensity;

        await InvokeAsync(StateHasChanged);
        ModuleConfig.SaveDeferred();
    }

    private async Task ResetDuration()
    {
        if (CurrentGroup == null) return;
        CurrentGroup.FixedDuration = ModuleConfig.Config.Behaviour.FixedDuration;
        CurrentGroup.DurationRange = ModuleConfig.Config.Behaviour.DurationRange;
        CurrentGroup.RandomDuration = ModuleConfig.Config.Behaviour.RandomDuration;

        await InvokeAsync(StateHasChanged);
        ModuleConfig.SaveDeferred();
    }

    private uint _limitBoneHeldDuration;
    private bool _limitBoneHeldDurationEnabled;

    protected override void OnInitialized()
    {
        UnderscoreConfig.OnGroupConfigUpdate += OnGroupConfigUpdate;
    }

    private void OnGroupConfigUpdate()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UnderscoreConfig.OnGroupConfigUpdate -= OnGroupConfigUpdate;
    }

}
