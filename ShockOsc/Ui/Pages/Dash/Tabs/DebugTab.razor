@using OpenShock.Desktop.ModuleBase
@using OpenShock.Desktop.ModuleBase.Api
@using OpenShock.ShockOSC.Services
@using OpenShock.ShockOSC.Ui.Utils
@using OpenShock.Internal.Common.Utils
@implements IAsyncDisposable

@page "/dash/debug"

<SettingsPage Title="Debug" Description="Live view of what ShockOSC is receiving from the game.">

    <SettingSection Icon="@Icons.Material.Filled.Cable" Title="Connection">
        <HeaderContent>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                     Color="@(ShockOsc.IsGameConnected ? Color.Success : Color.Error)">
                @(ShockOsc.IsGameConnected
                    ? ShockOsc.IsConnectedViaOscQuery ? "Connected via OSCQuery" : "Connected manually"
                    : "Not connected")
            </MudChip>
        </HeaderContent>
        <ChildContent>
            <SettingRow Label="Avatar" Description="The avatar ShockOSC is currently reading parameters from.">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @(string.IsNullOrEmpty(ShockOsc.AvatarId) ? "None detected" : ShockOsc.AvatarId)
                </MudText>
            </SettingRow>
        </ChildContent>
    </SettingSection>

    <SettingSection Icon="@Icons.Material.Filled.Tag" Title="OSC Parameters">
        <HeaderContent>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@VisibleParams.Count shown</MudText>
        </HeaderContent>
        <ChildContent>
            <SettingRow Label="Show all avatar parameters"
                        Description="Include parameters that do not belong to ShockOSC.">
                <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_showAllAvatarParams"/>
            </SettingRow>

            <MudDivider/>

            <div class="py-3">
                <MudTextField T="string" DebounceInterval="50" Variant="Variant.Outlined" Margin="Margin.Dense"
                              @bind-Value="_search" Placeholder="Search parameters" Clearable="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"/>
            </div>

            @if (VisibleParams.Count == 0)
            {
                <MudDivider/>
                <div class="py-3">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @(string.IsNullOrEmpty(_search) ? "No parameters received yet." : "No parameters match that search.")
                    </MudText>
                </div>
            }
            else
            {
                @foreach (var param in VisibleParams)
                {
                    <MudDivider/>
                    <div class="d-flex align-center justify-space-between gap-4 py-2">
                        <MudText Typo="Typo.body2" Style="word-break: break-all;">@param.Key</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Primary" Class="flex-none">@param.Value</MudText>
                    </div>
                }
            }
        </ChildContent>
    </SettingSection>

</SettingsPage>

@code {

    [ModuleInject] private ShockOsc ShockOsc { get; set; } = null!;
    [ModuleInject] private IOpenShockService OpenShock { get; set; } = null!;

    private bool _showAllAvatarParams = false;
    private string _search = "";

    private List<KeyValuePair<string, object?>> VisibleParams =>
        (_showAllAvatarParams ? ShockOsc.AllAvatarParams : ShockOsc.ShockOscParams)
            .Where(x => x.Key.Contains(_search, StringComparison.InvariantCultureIgnoreCase))
            .ToList();

    private void OnParamsChange(bool shockOscParam)
    {
        // only redraw page when needed
        if (!_showAllAvatarParams && !shockOscParam)
            return;

        _updateQueued = true;
    }

    private bool _updateQueued = true;

    protected override void OnInitialized()
    {
        _onParamsVhangeSubscription = ShockOsc.OnParamsChangeObservable.Subscribe(OnParamsChange);
        ShockOsc.OnGameConnectionChanged += OnConnectionChanged;

        OsTask.Run(UpdateParams);
    }

    private void OnConnectionChanged() => _updateQueued = true;

    private async Task UpdateParams()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        while (await timer.WaitForNextTickAsync(_cts.Token))
        {
            if (!_updateQueued) continue;
            _updateQueued = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private CancellationTokenSource _cts = new CancellationTokenSource();
    private IDisposable? _onParamsVhangeSubscription;


    public async ValueTask DisposeAsync()
    {
        ShockOsc.OnGameConnectionChanged -= OnConnectionChanged;
        _onParamsVhangeSubscription?.Dispose();
        await _cts.CancelAsync();
    }

}
